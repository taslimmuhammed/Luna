<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: a side-by-side test of the phone's models, started from adb. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- DUMP: only the shell (adb) and the system hold it, so no app can start this. -->
        <receiver
            android:name="com.local.assistant.debug.ModelProbeReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.local.assistant.debug.MODEL_PROBE" />
            </intent-filter>
        </receiver>
        <!-- Whether Nano answers over the lock screen; started from adb, as above. -->
        <activity
            android:name="com.local.assistant.debug.LockProbeActivity"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
